rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function peerUid() {
      return resource.data.participants[0] == request.auth.uid
        ? resource.data.participants[1]
        : resource.data.participants[0];
    }

    function validConversationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['ctx', 'lastMessage', 'unread', 'updatedAt'])
        && (!changed.hasAny(['lastMessage'])
          || request.resource.data.lastMessage.senderId == request.auth.uid)
        && (!changed.hasAny(['unread'])
          || (changed.hasAny(['lastMessage'])
            && request.resource.data.unread.diff(resource.data.unread)
              .affectedKeys().hasOnly([peerUid()]))
          || (!changed.hasAny(['lastMessage'])
            && request.resource.data.unread.diff(resource.data.unread)
              .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.unread[request.auth.uid] == 0));
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'phone', 'extra', 'createdAt', 'updatedAt'
        ]);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow delete: if false;

      match /pushTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'role', 'roles', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role in ['pemesan', 'justipper']
        && request.resource.data.roles is list
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles.hasOnly(['pemesan', 'justipper']);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'updatedAt', 'roles'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles'])
          || (request.resource.data.roles is list
            && request.resource.data.roles.size() <= 2
            && request.resource.data.roles.hasOnly(['pemesan', 'justipper'])
            && request.resource.data.roles.hasAll(resource.data.get('roles', [resource.data.role]))
            && request.resource.data.roles.hasAll([resource.data.role])));
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participantProfiles.keys().hasAll(request.resource.data.participants)
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participants[1]))
        && get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participants[0])).data
          .get('roles', [get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participants[0])).data.role])
          .hasAny([request.resource.data.participantProfiles[request.resource.data.participants[0]].role])
        && get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participants[1])).data
          .get('roles', [get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.participants[1])).data.role])
          .hasAny([request.resource.data.participantProfiles[request.resource.data.participants[1]].role])
        && request.resource.data.participantProfiles[request.resource.data.participants[0]].role
          != request.resource.data.participantProfiles[request.resource.data.participants[1]].role;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && validConversationUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(conversationId);
        allow create: if isParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data
            .get('roles', [get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.role])
            .hasAny([request.resource.data.senderRole])
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderRole', 'text', 'imageUrl', 'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.imageUrl is string
          && request.resource.data.createdAt is timestamp
          && (request.resource.data.text.size() > 0 || request.resource.data.imageUrl.size() > 0);
        allow update, delete: if false;
      }
    }
  }
}
